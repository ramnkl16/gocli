proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host ${NETSTORAGE_HOST_HEADER};
proxy_ssl_server_name on;
proxy_ssl_name ${NETSTORAGE_HOST_HEADER};

# /na/image.jpeg → /{cpcode}/assets/{brand}/na/image.jpeg
rewrite ^/(.*)$ /$ns_cp_code/$ns_assets_root/$ns_brand_folder/$1 break;

proxy_pass ${NETSTORAGE_SCHEME}://netstorage;

proxy_cache netstorage_cache;
proxy_cache_valid 200 302 10m;
proxy_cache_valid 404 1m;
proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
add_header X-Cache-Status $upstream_cache_status always;
add_header X-NetStorage-Root "/$ns_cp_code/$ns_assets_root/$ns_brand_folder" always;
add_header X-Brand-Folder $ns_brand_folder always;

proxy_connect_timeout 10s;
proxy_send_timeout 30s;
proxy_read_timeout 30s;
