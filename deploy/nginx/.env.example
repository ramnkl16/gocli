# Copy to .env and adjust for your Akamai contract.

# local | netstorage
NGINX_DOMAIN_MODE=local

# Akamai NetStorage edge hostname (Property Manager → Origin → NetStorage).
NETSTORAGE_HOSTNAME=your-storage-group.ns.edgekey.net
NETSTORAGE_HOST_HEADER=your-storage-group.ns.edgekey.net
NETSTORAGE_SCHEME=https

# CP codes and paths — edit domain-config.yaml and conf.d/domains.conf together.
