# gocli — example environment file
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env          # macOS / Linux
#     Copy-Item .env.example .env   # PowerShell
#
# `.env` and `.env.local` are gitignored. Anything you set in your real
# OS environment always wins over a value in this file.
#
# Set GOCLI_NO_DOTENV=1 (in your real shell) to disable .env loading
# entirely — useful in CI.

# ── Secrets ──────────────────────────────────────────────────────────
# These are normally stored in the OS keyring after `gocli auth login`.
# Setting them here is convenient for local dev or for CI runners that
# have no keyring available.

# Atlassian / Jira API token
# Create one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# GitHub personal access token (classic or fine-grained).
# Required scopes: repo, read:org
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Cursor Agent CLI — used by `gocli jira implement`
# Auth: run `agent login` once, or set this for headless/CI use.
# Create at: https://cursor.com/settings (API keys)
# CURSOR_API_KEY=

# Override Cursor Agent executable (default: agent on PATH)
# GOCLI_CURSOR_BINARY=C:\path\to\agent.exe

# ── Email notifications (SMTP) ─────────────────────────────────────────
# Used by `gocli email notify` and optional auto-notify on deploy / jira transition.
# GOCLI_EMAIL_SMTP_HOST=smtp.company.com
# GOCLI_EMAIL_SMTP_PORT=587
# GOCLI_EMAIL_FROM=gocli-bot@company.com
# GOCLI_EMAIL_SMTP_USER=gocli-bot@company.com
# GOCLI_SMTP_PASSWORD=
# GOCLI_EMAIL_DEVOPS_TO=devops@company.com
# GOCLI_EMAIL_DEPLOY_TO=deploy@company.com

# ── Optional config overrides ────────────────────────────────────────
# Override the directory holding gocli's config and caches.
# Default: %USERPROFILE%\.gocli on Windows, $HOME/.gocli elsewhere.
# GOCLI_HOME=./.gocli

# Override the full path to the config file directly.
# Wins over GOCLI_HOME. Default: <GOCLI_HOME>/config.yaml
# GOCLI_CONFIG=./.gocli/config.yaml
